# Copy this to the TLS-terminating reverse proxy that serves the built portal
# and the API on ONE HTTPS origin.  Replace every literal
# `portal.example.com` below (including the redirect target and certificate
# paths) before enabling it.  The redirect intentionally uses that canonical
# literal rather than `$host`: an unmatched Host header must never choose a
# login-page redirect destination.  Keep docker-compose's API port on
# 127.0.0.1:8000; do not expose it directly to the Internet.
#
# When this proxy is enabled, set both variables on the API service:
#   MINDPATTERN_TRUST_PROXY_HEADERS=1
#   MINDPATTERN_TRUSTED_PROXY_IPS=<the peer IP/CIDR API sees for nginx>
# The image entrypoint refuses proxy-header mode without an explicit trusted
# proxy allowlist.  This is the source address visible *inside the API
# container*, not necessarily the host's loopback: a host nginx reaching a
# Docker published port commonly appears as the Docker bridge gateway. Check
# the API's direct peer in a controlled test/deployment and allowlist only
# that fixed address/CIDR. If nginx runs in another container/host, use its
# fixed private address/CIDR instead.

server {
    listen 80;
    listen [::]:80;
    server_name portal.example.com;
    return 301 https://portal.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name portal.example.com;

    ssl_certificate     /etc/letsencrypt/live/portal.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    server_tokens off;
    client_max_body_size 2m;
    # Match the API's complete-body deadline. A client cannot retain an nginx
    # connection indefinitely by drip-feeding an otherwise valid body.
    client_body_timeout 30s;
    send_timeout 30s;

    # This product deliberately retains no web request inventory.  Send
    # infrastructure health telemetry separately and only after its retention
    # policy has been reviewed; do not re-enable access logs by default.
    access_log off;

    # Browser hardening belongs at the static host, not just in the API.
    # The React portal intentionally uses inline style attributes for its
    # dynamic theme. Keep this aligned with portal/public/_headers and its
    # meta fallback: a stricter second CSP would intersect and block the UI.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control "no-store" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    root /srv/mindpattern/portal/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        # Keep Host canonical too.  `$host` is client-derived and can feed
        # framework-generated absolute redirects (for example a slash
        # canonicalization) if it is forwarded upstream.  Replace this
        # literal alongside every other portal.example.com occurrence when
        # installing the template.
        proxy_set_header Host portal.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        # Append nginx's direct peer observation.  The API deliberately uses
        # the RIGHTMOST value, so a client-controlled leftmost value cannot
        # choose its rate-limit identity.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # Vite's SPA needs the fallback.  The portal handles health data, so its
    # shell and assets intentionally inherit no-store rather than leaving
    # account-adjacent UI in shared-browser caches.
    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
