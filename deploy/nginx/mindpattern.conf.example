# Copy this to the TLS-terminating reverse proxy that serves the built portal
# and the API on ONE HTTPS origin.  Replace every literal
# `portal.example.com` below (including the redirect target and certificate
# paths) before enabling it.  The redirect intentionally uses that canonical
# literal rather than `$host`: an unmatched Host header must never choose a
# login-page redirect destination.  Keep docker-compose's API port on
# 127.0.0.1:8000; do not expose it directly to the Internet.
#
# DEPLOYMENT PREREQUISITES (2026-09-26 infra audit — a conf.d drop-in at the
# wrong context level fails the reload with opaque errors):
#   * This file is an HTTP-CONTEXT snippet: it must be INCLUDED at http{}
#   level (include /etc/nginx/conf.d/*.conf does this; do NOT paste it
#   inside a server{} or stream{} block).
#   * `http2 on;` (the new-style directive used below) requires
#   nginx >= 1.25.1 — on older nginx, use the legacy per-listen http2
#   parameter form on each listen line instead.
#   * limit_req_zone below is valid ONLY in the http context — one more
#   reason this file cannot be server-scoped.
#
# When this proxy is enabled, set both variables on the API service:
#   MINDPATTERN_TRUST_PROXY_HEADERS=1
#   MINDPATTERN_TRUSTED_PROXY_IPS=<the peer IP/CIDR API sees for nginx>
# The API's CONFIG VALIDATION (backend/app/config.py — not the image
# entrypoint; the entrypoint only runs migrations) refuses proxy-header
# mode without an explicit trusted proxy allowlist.  This is the source
# address visible *inside the API container*, not necessarily the host's
# loopback: a host nginx reaching a Docker published port commonly appears
# as the Docker bridge gateway. Check the API's direct peer in a
# controlled test/deployment and allowlist only that fixed address/CIDR.
# If nginx runs in another container/host, use its fixed private
# address/CIDR instead.

# Edge rate limiting: shed request floods BEFORE they occupy an application
# concurrency slot (--limit-concurrency 100) or a scrypt worker. The API's
# own fixed-window limiter remains the authoritative policy; this zone is
# coarse outer armor sized for a clinical-caseload deployment, not a
# substitute for it. 10 requests/second/IP with a small burst allowance.
limit_req_zone $binary_remote_addr zone=edge_api:10m rate=10r/s;
# 429, not nginx's default 503 (audit 2026-09-26): deliberate throttling
# is not a server error, and the clients already speak 429 — the API's own
# limiter answers `rate_limited` + Retry-After with it. A 503 here would
# pollute the 5xx signal every synthetic/monitoring watch uses for real
# failures (the 5xx-ratio alert's whole premise).
limit_req_status 429;

server {
    listen 80;
    listen [::]:80;
    server_name portal.example.com;
    return 301 https://portal.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name portal.example.com;

    ssl_certificate     /etc/letsencrypt/live/portal.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # TLSv1.2 cipher suite tuned to the modern (Mozilla "intermediate")
    # profile: AEAD-only, forward secrecy only. TLSv1.3 cipher suites are
    # fixed by the protocol and not configurable here.
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    # Let the CLIENT pick its TLSv1.2 suite (all listed are strong);
    # preferring server order only helps against exotic legacy clients.
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    # Session tickets off: the ticket key would outlive the certificate's
    # forward-secrecy story on a long-lived proxy host.
    ssl_session_tickets off;
    # OCSP stapling: the proxy fetches and pins the CA's revocation answer
    # so clients do not leak their browsing of this origin to the CA, and
    # revocation actually works for clients behind blocking middleboxes.
    # Needs the chain + a resolver for the OCSP responder's hostname.
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/portal.example.com/chain.pem;
    resolver 9.9.9.9 1.1.1.1 valid=300s;
    resolver_timeout 5s;

    server_tokens off;
    client_max_body_size 2m;
    # Match the API's complete-body deadline. A client cannot retain an nginx
    # connection indefinitely by drip-feeding an otherwise valid body.
    client_body_timeout 30s;
    send_timeout 30s;

    # This product deliberately retains no web request inventory.  Send
    # infrastructure health telemetry separately and only after its retention
    # policy has been reviewed; do not re-enable access logs by default.
    access_log off;

    # Browser hardening belongs at the static host, not just in the API.
    # Keep this aligned with portal/public/_headers and portal/index.html's
    # meta fallback: a stricter second CSP would intersect and block the UI.
    # Since 2026-09-26 there is no 'unsafe-inline' anywhere — the shell's
    # stylesheets are the same-origin /portal.css and /print.css, and the
    # views' former inline style objects are portal.css classes now, so
    # style-src needs no inline escape (SVG stroke/fill are attributes,
    # which style-src does not govern). FE-2 (pentest 2026-09-29): this
    # template had kept the pre-hardening escape hatch — and its stale
    # justifying comment — after every pinned portal copy dropped it; the
    # X-Robots-Tag below is the same noindex the patient-web block ships.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control "no-store" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    root /srv/mindpattern/portal/dist;
    index index.html;

    # EXACT /api must be owned by the API too: `location /api/` alone does
    # not match the bare path, and the SPA fallback below would otherwise
    # answer the legacy mount with index.html + 200 — a web shell where the
    # client expects an API (2026-09-19 audit, L-89).
    location = /api {
        limit_req zone=edge_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host portal.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # VOICE_PLAN (remediated 2026-09-29, M8): the audio upload/transcription
    # routes carry base64 recordings the app itself caps at 4 MiB
    # (MINDPATTERN_AUDIO_MAX_BODY_BYTES). The generic 2m would proxy-413
    # uploads the app accepts. Keep this location BEFORE the generic
    # /api/ block (longest-prefix match wins) and raise the app cap in
    # lockstep if this value ever changes.
    location ~ ^/api/(v1/)?audio/ {
        limit_req zone=edge_api burst=20 nodelay;
        client_max_body_size 8m;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host portal.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        # A 5-minute take's transcription round-trip is server-budgeted at
        # 120s; give the edge the same patience as the streamed export.
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location /api/ {

        limit_req zone=edge_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        # Keep Host canonical too.  `$host` is client-derived and can feed
        # framework-generated absolute redirects (for example a slash
        # canonicalization) if it is forwarded upstream.  Replace this
        # literal alongside every other portal.example.com occurrence when
        # installing the template.
        proxy_set_header Host portal.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        # Append nginx's direct peer observation.  The API deliberately uses
        # the RIGHTMOST value, so a client-controlled leftmost value cannot
        # choose its rate-limit identity.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        # The streamed account export legitimately holds an unbuffered
        # upstream connection open for the whole download; the nginx default
        # upstream read timeout (60s) can cut a very large journal mid-page.
        # 300s matches the backup window's patience without making a wedged
        # worker permanent.
        proxy_read_timeout 300s;
        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # Vite's SPA needs the fallback.  The portal handles health data, so its
    # shell and assets intentionally inherit no-store rather than leaving
    # account-adjacent UI in shared-browser caches.
    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---------------------------------------------------------------------------
# Patient web client (web/) — LIVE BLOCK (WEB_PLAN P10.1). Its own HTTPS
# subdomain with its own /api proxy, so the patient app is same-origin with
# the API exactly like the portal (WEB_PLAN D-5) and
# MINDPATTERN_CORS_ORIGINS stays empty. Static root: the release tarball's
# dist/, extracted to /srv/mindpattern/web/dist (same "extract, never build
# on prod" rule as the portal). The header set MUST stay aligned with
# web/public/_headers and web/index.html's meta fallback — pinned by
# web/tests/securityConfig.test.ts. The proxy stanza mirrors the portal's
# (edge rate limit shared zone, canonical Host literal, rightmost-IP
# forwarding, 300s read timeout for the streamed export, buffering off).

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;
    return 301 https://app.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.example.com;

    ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/app.example.com/chain.pem;
    resolver 9.9.9.9 1.1.1.1 valid=300s;
    resolver_timeout 5s;

    server_tokens off;
    client_max_body_size 2m;
    client_body_timeout 30s;
    send_timeout 30s;
    access_log off;

    # Keep this aligned with web/public/_headers: a stricter second CSP
    # would intersect and block the UI. Since 2026-09-26 there is no
    # 'unsafe-inline' anywhere — the stylesheet is the same-origin
    # /app.css and all dynamic styling is React's CSSOM inline-style path,
    # which style-src does not govern.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src 'none'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control "no-store" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), display-capture=(), idle-detection=(), browsing-topics=(), serial=(), bluetooth=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    # preload: submitting the domain to hstspreload.org is an operator
    # step; the header ships ready for it. See deploy/README.md.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    root /srv/mindpattern/web/dist;
    index index.html;

    # Same exact-/api ownership rule as the portal block (the SPA fallback
    # must never answer the API mount with HTML).
    location = /api {
        limit_req zone=edge_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host app.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # VOICE_PLAN (remediated 2026-09-29, M8): the audio upload/transcription
    # routes carry base64 recordings the app itself caps at 4 MiB
    # (MINDPATTERN_AUDIO_MAX_BODY_BYTES). The generic 2m would proxy-413
    # uploads the app accepts. Keep this location BEFORE the generic
    # /api/ block (longest-prefix match wins) and raise the app cap in
    # lockstep if this value ever changes.
    location ~ ^/api/(v1/)?audio/ {
        limit_req zone=edge_api burst=20 nodelay;
        client_max_body_size 8m;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host app.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        # A 5-minute take's transcription round-trip is server-budgeted at
        # 120s; give the edge the same patience as the streamed export.
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location /api/ {

        limit_req zone=edge_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host app.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        # The streamed account export holds the connection open for the
        # whole download (same 300s patience as the portal).
        proxy_read_timeout 300s;
        proxy_buffering off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
