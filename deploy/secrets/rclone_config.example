# rclone config INI for the off-site replication overlay (remote name
# + S3 credentials). Copy to "rclone_config", fill, chmod 600 — never commit
# the real one. Example remote:
#
#   [s3-offsite]
#   type = s3
#   provider = Other
#   access_key_id = OPERATOR-FILL
#   secret_access_key = OPERATOR-FILL
#   endpoint = OPERATOR-FILL
