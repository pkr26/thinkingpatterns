# Public release-image fragment — NOT a secrets file.
#
# Each tagged GitHub release publishes a filled-in
# `mindpattern-release-v*.env` asset. Download that exact asset rather than
# editing this example. The values must be manifest-list digests, never tags
# such as `latest` or `v1.2.3`; `deploy/verify-release-env.sh` checks this
# shape before deployment.
#
# Keep MINDPATTERN_TOKEN_SECRET, POSTGRES_PASSWORD, BACKUP_KEY, and any proxy
# settings in a separate, owner-only secrets env file. Never attach secrets
# to a public GitHub release.
MINDPATTERN_API_IMAGE=ghcr.io/OWNER/REPOSITORY@sha256:REPLACE_WITH_64_LOWERCASE_HEX_DIGEST
MINDPATTERN_BACKUP_IMAGE=ghcr.io/OWNER/REPOSITORY-backup@sha256:REPLACE_WITH_64_LOWERCASE_HEX_DIGEST
