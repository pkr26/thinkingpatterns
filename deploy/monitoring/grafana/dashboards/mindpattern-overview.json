{
  "__inputs": [],
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["mindpattern"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "MindPattern overview",
  "uid": "mindpattern-overview",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API up (mindpattern-api scrape)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [{ "refId": "A", "expr": "max(up{job=\"mindpattern-api\"})" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Live processing sessions (keystore)",
      "description": "mindpattern_keystore_sessions — S2 at >16 sustained for 15m (4x the analyze slots across three full TTL windows); escalates to S1 per the runbook's plaintext-exposure checklist. Orange = approaching the alert boundary.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [{ "refId": "A", "expr": "max(mindpattern_keystore_sessions)" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 8 }, { "color": "red", "value": 16 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hours since last successful backup",
      "description": "From the textfile heartbeat (backup-heartbeat.sh). Alert fires past 26h.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "(time() - max(mindpattern_backup_last_success_timestamp_seconds)) / 3600" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 24 }, { "color": "red", "value": 26 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5xx share of responses (5m)",
      "description": "Empty = no 5xx series yet (the exposition only creates a status family after its first response) — healthy, not broken.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(mindpattern_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(mindpattern_requests_total[5m])), 1e-9)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by status family",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(mindpattern_requests_total[5m]))", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Recompute latency (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(mindpattern_recompute_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mindpattern_recompute_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Recomputes per second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(mindpattern_recompute_seconds_count[5m]))", "legendFormat": "recomputes" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20 } }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Optional LLM analyzer: calls by outcome",
      "description": "Series appear only when MINDPATTERN_LLM_URL is configured and used.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(mindpattern_llm_calls_total[5m]))", "legendFormat": "{{outcome}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Audit-chain verification failures (1h)",
      "description": "mindpattern_audit_chain_failures — daily sweep result, counting FAILED patient trails (not rows). S2 at any increase: the access-log chain is the tamper evidence for breach assessment.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(mindpattern_audit_chain_failures[1h]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Audit prune: oldest overdue",
      "description": "Hours beyond the configured retention cutoff. S2 alert above 2h for 15m.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(mindpattern_audit_prune_oldest_overdue_seconds) / 3600" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Audit verification cycle age",
      "description": "Age of the durable incomplete verification cycle. S2 alert above 2h for 15m.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(mindpattern_audit_verification_cycle_age_seconds) / 3600" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Audit maintenance failures (15m)",
      "description": "Any increment is S2; readiness remains closed until a complete authenticated pass succeeds.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(mindpattern_audit_maintenance_failures_total[15m]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Bounded audit-maintenance backlog probes",
      "description": "Boolean catch-up flags plus capped pending-row/owner probes. Use cursor movement and age panels to distinguish progress from a stall.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(mindpattern_audit_prune_backlog)", "legendFormat": "prune backlog" },
        { "refId": "B", "expr": "max(mindpattern_audit_prune_pending_rows_probe)", "legendFormat": "pending rows (capped probe)" },
        { "refId": "C", "expr": "max(mindpattern_audit_verification_backlog)", "legendFormat": "verification backlog" },
        { "refId": "D", "expr": "max(mindpattern_audit_verification_pending_owners_probe)", "legendFormat": "pending owners (capped probe)" }
      ],
      "fieldConfig": { "defaults": { "decimals": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Account-erasure bounded purge",
      "description": "Capped pending-job probe and oldest request age. Logical erasure is immediate; these track physical purge convergence without account labels.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(mindpattern_account_deletion_pending_probe)", "legendFormat": "pending probe (capped)" },
        { "refId": "B", "expr": "max(mindpattern_account_deletion_oldest_seconds) / 3600", "legendFormat": "oldest age (hours)" }
      ],
      "fieldConfig": { "defaults": { "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Account-erasure worker failures",
      "description": "Fixed privacy-safe failure categories only; no exception text, identifiers, paths, or object keys.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "mindpattern-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (category) (increase(mindpattern_account_deletion_failures_total[15m]))", "legendFormat": "{{category}}" }
      ],
      "fieldConfig": { "defaults": { "decimals": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] }
    }
  ]
}
