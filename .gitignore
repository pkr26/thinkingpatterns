# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mutmut-cache
mutants/
htmlcov/
.coverage

# Node / React Native
node_modules/
mobile/build/
mobile/ios/Pods/
mobile/android/.gradle/
mobile/android/app/build/
mobile/.verify-build/
mobile/.decrypt-build/
coverage/
*.log

# Local state
*.db
*.sqlite3
.env

# SQLite sidecar files (L-3, 2026-09-20): *.db does NOT match the WAL/SHM
# journals — they hold committed-but-uncheckpointed row images (salts,
# verifiers, ciphertext) and were one `git add -A` away from a commit.
*.db-wal
*.db-shm
*.db-journal

# Local simulation/dev database artifacts (L-4): contains password
# verifiers for synthetic accounts — kept out of the checkout root.
backend/.artifacts/

# dev artifacts — never commit real databases
backend/mindpattern.db
backend/demo.db
.tools/

# Monitoring scrape credential (0600, operator-created — never commit)
deploy/monitoring/token

# Tool caches (local-only)
.ruff_cache/
.mypy_cache/
.pre-commit-cache

# Portal build output
portal/dist/

# Generated security-campaign outputs (regenerated by each run; only the
# harnesses and corpora are source)
redteam/results/
redteam/mutation_campaign_*/results/
mobile/reports/
portal/reports/

# Native project build/state artifacts (2026-09-21: ios/ + android/ now ship
# in-tree; everything a per-machine build regenerates stays out)
mobile/ios/build/
mobile/ios/DerivedData/
mobile/ios/*.xcuserstate
mobile/ios/*.xcworkspace/xcuserdata/
mobile/ios/.bundle/
mobile/ios/vendor/
mobile/android/local.properties
mobile/android/.kotlin/
mobile/android/build/
mobile/android/app/release/
mobile/android/keystore.properties
*.keystore
!mobile/android/app/debug.keystore
