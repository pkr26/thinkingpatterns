# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/
.mutmut-cache
mutants/
htmlcov/
.coverage

# Node / React Native
node_modules/
mobile/build/
mobile/ios/Pods/
mobile/android/.gradle/
mobile/android/app/build/
mobile/.verify-build/
mobile/.decrypt-build/
coverage/
*.tsbuildinfo
*.log
# Reviewed synthetic validation evidence accompanies the October 3 reports.
!reports/audit-2026-10-03/validation-logs/*.log
!reports/remediation-2026-10-03/validation-logs/*.log
!reports/independent-commit-audit-2026-10-03/mobile/*.log

# Local state
.DS_Store
*.db
*.sqlite3
.env

# SQLite sidecars contain database content and must stay local.
*.db-wal
*.db-shm
*.db-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Local simulation state and runtime audio objects
backend/.artifacts/

backend/data/
.tools/

# Monitoring scrape credential (0600, operator-created — never commit)
deploy/monitoring/token

# Tool caches (local-only)
.ruff_cache/
.mypy_cache/
.pre-commit-cache

# Portal build output
portal/dist/

# Web client build output + mutation reports
web/dist/
web/reports/

# Generated security-campaign outputs (regenerated by each run; only the
# harnesses and corpora are source)
redteam/results/
redteam/mutation_campaign_*/results/
mobile/reports/
portal/reports/

# Native build output and per-machine state
mobile/ios/build/
mobile/ios/DerivedData/
mobile/ios/*.xcuserstate
mobile/ios/*.xcworkspace/xcuserdata/
mobile/ios/.bundle/
mobile/ios/vendor/
mobile/android/local.properties
mobile/android/.kotlin/
mobile/android/build/
mobile/android/app/release/
mobile/android/keystore.properties
*.keystore
!mobile/android/app/debug.keystore

# Private keys and signing material; reviewed fixtures need explicit exceptions.
*.pem
*.key
*.p12
*.jks
id_rsa*

# ZCode local session artifacts
.zcode/

# Stryker sandbox (in-place temp; only present if a run is killed mid-flight)
stryker-tmp/

# File-mounted secrets: commit only example templates.
deploy/secrets/*
!deploy/secrets/*.example

# Alertmanager receiver config (fail-closed mount): only the example ships.
deploy/monitoring/alertmanager/alertmanager.yml

# Browser drill screenshots can contain decrypted journals and enrollment secrets.
gui-test-screenshots/
e2e_gui/screenshots/
e2e_gui/audit_screenshots/
