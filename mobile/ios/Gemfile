source 'https://rubygems.org'

# Match the signing-independent CI toolchain. Keeping one supported Ruby minor
# makes the CocoaPods closure reproducible instead of accepting a version whose
# stdlib/gem constraints differ materially from the runner.
ruby "~> 3.3.0"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'xcodeproj', '< 1.26.0'
# 3.0.9 declares Ruby <3.2 and therefore cannot install on the CI Ruby 3.3
# selected above; 3.0.7 is the latest compatible release in xcodeproj's range.
gem 'CFPropertyList', '3.0.7'
gem 'concurrent-ruby', '< 1.3.4'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
