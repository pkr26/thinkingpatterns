# Copy to mobile/android/keystore.properties (gitignored) and fill in your
# PRIVATE release keystore. A release build without this file fails the
# gradle taskGraph guard — release artifacts are never silently signed
# with the public debug key (audit F-1, 2026-09-26).
#
# Generate a keystore once:
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore mindpattern-release.keystore -alias mindpattern \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile resolves relative to mobile/android/app/ (an absolute path
# also works). Never commit the real keystore or this filled-in file.
storeFile=../../mindpattern-release.keystore
storePassword=CHANGE_ME
keyAlias=mindpattern
keyPassword=CHANGE_ME
