{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "inPlace": false,
  "vitest": {
    "configFile": "./vitest.mutation.config.ts",
    "related": true
  },
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "App.tsx",
    "index.js",
    "installPolyfills.cjs"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "progress",
    "json",
    "mutation-events"
  ],
  "appendPlugins": ["./tools/mutation_event_reporter.mjs"],
  "thresholds": {
    "break": 84
  },
  "timeoutMS": 60000,
  "concurrency": 4,
  "tempDirName": "stryker-tmp",
  "allowConsoleColors": true
}
