{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "//": "thresholds.break is the regression floor from the 2026-09-15 full campaign (4,356 mutants, 99.64% measured; 15 documented survivors \u2014 see ../../reports/mutation_report_mobile_2026-09-15.md).",
  "testRunner": "vitest",
  "inPlace": true,
  "vitest": {
    "configFile": "./vitest.config.ts",
    "related": false
  },
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "coverageAnalysis": "all",
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "thresholds": {
    "break": 99
  },
  "timeoutMS": 60000,
  "tempDirName": "stryker-tmp",
  "allowConsoleColors": true
}
