{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@crypto/*": ["src/crypto/*"], "@api/*": ["src/api/*"] }
  },
  "include": ["App.tsx", "index.js", "src/**/*"],
  "exclude": ["node_modules"]
}
