{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "inPlace": true,
  "vitest": {
    "configFile": "./vite.config.ts",
    "related": false
  },
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "coverageAnalysis": "all",
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "thresholds": {
    "break": 1
  },
  "timeoutMS": 60000,
  "concurrency": 2,
  "tempDirName": "stryker-tmp",
  "allowConsoleColors": false
}
