{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node_modules/.bin/vitest run --coverage.enabled=false --silent"
  },
  "inPlace": true,
  "mutate": [
    "src/crypto.ts",
    "src/aad.ts",
    "src/api.ts",
    "src/platform.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "thresholds": {
    "break": 70
  },
  "timeoutMS": 120000,
  "concurrency": 1,
  "tempDirName": "stryker-tmp",
  "allowConsoleColors": false
}
