    <div>
      <h1>
        "patienta"
      <p className="note">
        "sharing since 2026-09-01 · read-only — you cannot change their data"
    <div className="no-print row row--wrap">
      <button className="btn btn--small" disabled=false type="button">
        "Print session summary"
      <button className="btn btn--small" disabled=false type="button">
        "Back to patients"
      <button className="btn btn--danger btn--small" disabled=false type="button">
        "Sign out"
  <div className="no-print row row--wrap mb-14">
    <button className="btn btn--small" disabled=false type="button">
      "Mark reviewed (start the delta anchor)"
    <span className="hint">
      "The new-pattern count anchors the first time you mark reviewed."
  <section className="card">
    <h2 className="card__title">
      "Baseline phase"
    <p className="note">
      "No pattern data has been computed yet for this patient."
  <section className="card no-print">
    <h2 className="card__title">
      "General notes about this patient"
    <p className="note">
      "No notes yet."
    <div className="tpl-row">
      <span className="hint tpl-row__label">
        "Start from:"
      <button className="tpl-chip" type="button">
        "Session focus"
      <button className="tpl-chip" type="button">
        "Observed together"
      <button className="tpl-chip" type="button">
        "Homework / between-session plan"
      <button className="tpl-chip" type="button">
        "Questions for next visit"
    <textarea aria-label="New note about this patient" className="textarea" disabled=false maxLength=100000 placeholder="Note about this patient…" rows=3 value="">
    <div>
      <p className="note" role="status">
        "Drafts are encrypted on this device."
      <button className="btn" disabled=true type="button">
        "Save note"
    <details className="disclose">
      <summary>
        "How private clinician notes are encrypted"
      <div className="disclose__body">
        <p className="note note--muted">
          "Private clinician notes are encrypted under YOUR password before leaving this page. They are not shared with the patient or added to their journal, and may remain in your account after the patient stops sharing; delete them when your records policy requires it."
  <div className="print-only">
    <h1>
      "Fathom session summary — "
      "patienta"
    <p className="print-meta">
      "Sharing since 2026-09-01"
      " "
      "· summary generated "
      "2026-10-04"
    <p className="print-footer">
      "Observations from the patient's own encrypted journal — not a diagnosis. Generated by Fathom.""
`;

