// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`LoginView > drops the setup secret and verifier after MFA enable, and revokes an abandoned handoff > mandatory MFA enrollment and local QR 1`] = `
"<main className="login-main">
  <div className="login-wrap">
    <h1 className="login-title">
      "Fathom · Therapist portal"
    <section className="card">
      <h2 className="card__title">
        "Set up two-factor authentication to continue"
      <p className="note note--danger">
        "Patient data stays locked until two-factor authentication is enabled."
      <p className="note">
        "Add this account to your authenticator app, then enter its current 6-digit code."
      <div className="totp-secret">
        <code>
          "JBSWY3DPEHPK3PXP"
      <details className="disclose">
        <summary>
          "Can’t scan a QR code? Show the setup URI"
        <div className="disclose__body">
          <p className="note note--muted">
            <code>
              "otpauth://totp/Fathom:test"
      <div className="field">
        <label className="field__label" htmlFor="field-association-1">
          "Authenticator code"
        <input autoComplete="one-time-code" className="input" id="field-association-1" placeholder="123456" type="text" value="">
      <button className="btn" disabled=true type="button">
        "Enable two-factor authentication"
      <button className="btn btn--small" disabled=false type="button">
        "Cancel and sign out""
`;

exports[`LoginView > drops the setup secret and verifier after MFA enable, and revokes an abandoned handoff > one-time recovery codes after abandoned unlock 1`] = `
"<main className="login-main">
  <div className="login-wrap">
    <h1 className="login-title">
      "Fathom · Therapist portal"
    <section className="card">
      <h2 className="card__title">
        "Set up two-factor authentication to continue"
      <p className="note note--danger">
        "Patient data stays locked until two-factor authentication is enabled."
      <p className="note note--danger">
        "Save these one-time recovery codes now. They will not be shown again."
      <div className="totp-codes">
        <code>
          "ABCDE12345"
        <code>
          "FGHIJ67890"
      <button className="btn" disabled=false type="button">
        "I saved the codes — return to sign in"
      <div className="banner banner--error" role="alert">
        "Two-factor authentication is enabled, but the portal could not finish opening. Try signing in again."
      <button className="btn btn--small" disabled=false type="button">
        "Cancel and sign out""
`;

exports[`LoginView > requires a genuinely strong registration password while allowing a long passphrase > registration policy and minimum-age attestation 1`] = `
"<main className="login-main">
  <div className="login-wrap">
    <h1 className="login-title">
      "Fathom · Therapist portal"
    <section className="card">
      <h2 className="card__title">
        "Create a therapist account"
      <form className="login-form">
        <div className="field">
          <label className="field__label" htmlFor="field-association-1">
            "Your name (shown to patients)"
          <input autoComplete="name" className="input" id="field-association-1" placeholder="Dr. Jane Omega" type="text" value="">
        <div className="field">
          <label className="field__label" htmlFor="field-association-2">
            "Username"
          <input autoComplete="username" className="input" id="field-association-2" placeholder="dromega" type="text" value="drnew">
        <div className="field">
          <label className="field__label" htmlFor="field-association-3">
            "Password"
          <span className="field__row">
            <input autoComplete="new-password" className="input" id="field-association-3" type="password" value="one">
            <button className="btn btn--ghost btn--small" disabled=false type="button">
              "Show password"
        <div aria-label="Password strength: Weak" className="pw-meter" role="status">
          <span className="pw-meter__bar pw-meter__bar--1">
          <span className="pw-meter__bar">
          <span className="pw-meter__bar">
          <span className="pw-meter__bar">
          <span className="pw-meter__label pw-meter__label--1">
            "Weak"
        <div className="field">
          <label className="field__label" htmlFor="field-association-4">
            "Repeat password"
          <span className="field__row">
            <input autoComplete="new-password" className="input" id="field-association-4" type="password" value="one">
            <button className="btn btn--ghost btn--small" disabled=false type="button">
              "Show password"
        <div className="field">
          <label className="field__label" htmlFor="field-association-5">
            "Clinician enrollment token (if issued)"
          <input autoComplete="one-time-code" className="input" id="field-association-5" placeholder="Organization-issued token" type="password" value="">
        <label className="row">
          <input checked=false type="checkbox">
          <span>
            "I confirm that I am 18 or older."
        <p className="note">
          "Server: this portal's own secure origin. It cannot be changed from the sign-in screen."
        <p className="note">
          "Choose a password of at least 12 characters. Use a 16-character passphrase, or use at least three character types at 12–15 characters."
        <p className="note">
          "If your organization issued a clinician enrollment token, enter it here. It is sent only to this portal's same-origin secure API connection and is never stored by this portal."
        <p className="note note--danger">
          "There is no password reset and no account recovery. Your sharing key is wrapped to this password alone: if you forget it, your account and every shared note become permanently unreadable. Save the password in a password manager before you continue."
        <button className="btn" disabled=true type="submit">
          "Create account"
        <button className="btn btn--small" disabled=false type="button">
          "Back to sign in"
        <details className="disclose">
          <summary>
            "How your password is protected"
          <div className="disclose__body">
            <p className="note note--muted">
              "Your password never leaves this page: the server stores only a hash of a derived key, and your sharing key is decryptable only with your password.""
`;

exports[`LoginView > signs in: salt -> derive -> login -> onReady > sign-in fields and custody explanation 1`] = `
"<main className="login-main">
  <div className="login-wrap">
    <h1 className="login-title">
      "Fathom · Therapist portal"
    <section className="card">
      <h2 className="card__title">
        "Sign in"
      <form className="login-form">
        <div className="field">
          <label className="field__label" htmlFor="field-association-1">
            "Username"
          <input autoComplete="username" className="input" id="field-association-1" placeholder="dromega" type="text" value="drportal">
        <div className="field">
          <label className="field__label" htmlFor="field-association-2">
            "Password"
          <span className="field__row">
            <input autoComplete="current-password" className="input" id="field-association-2" type="password" value="">
            <button className="btn btn--ghost btn--small" disabled=false type="button">
              "Show password"
        <p className="note">
          "Server: this portal's own secure origin. It cannot be changed from the sign-in screen."
        <button className="btn" disabled=true type="submit">
          "Sign in"
        <button className="btn btn--small" disabled=false type="button">
          "Create a therapist account instead"
        <details className="disclose">
          <summary>
            "How your password is protected"
          <div className="disclose__body">
            <p className="note note--muted">
              "Your password never leaves this page: the server stores only a hash of a derived key, and your sharing key is decryptable only with your password.""
`;

