exports[`PatientsView > E (2026-09-26): entering the patient's id pulls the SAS beside the code, with compare-out-of-band copy > out-of-band patient pairing verification 1`] = `
"<main className="portal-main">
  <header className="portal-head">
    <h1>
      "Patients — "
      "Dr. Portal"
    <button className="btn btn--small" disabled=false type="button">
      "Sign out"
  <section className="card">
    <h2 className="card__title">
      "Connect a new patient"
    <p className="note">
      "Generate a pairing code and read it to your patient. They enter it in their app, see your name, and confirm with their password. The code works once and expires in 15 minutes."
    <p className="pairing-code" data-testid="pairing-code">
      "7X2KQM4N"
    <hr className="divider">
    <div className="field">
      <label className="field__label" htmlFor="field-association-1">
        "Patient's account id (shown in their app)"
      <input autoComplete="off" className="input" id="field-association-1" placeholder="32 characters" type="text" value="0123456789abcdef0123456789abcdef">
    <button className="btn btn--small" disabled=false type="button">
      "Show verification code"
    <p className="pairing-code" data-testid="pairing-sas">
      "482 913"
    <p className="note note--warn">
      "This portal could not compute the fingerprint of your own sharing key, so the local cross-check against the server's key id could not run — only the out-of-band comparison of the verification code and key fingerprint with your patient verifies this pairing's key. Do not treat the key id above as verified."
    <p className="note note--warn">
      "Verification code for this pairing (key id "
      "a1b2c3d4e5f60718"
      "). "
      "The patient's app shows the same code after they enter yours — read it to each other and confirm it matches EXACTLY before they confirm sharing. A"
      "mismatch means the account id was entered wrong here or a key was substituted: re-check the id first, then generate a new code and do not proceed."
    <button className="btn" disabled=false type="button">
      "Generate pairing code"
  <h3 className="section-label section-label--gap">
    "ACTIVE"
  <p className="note">
    "No patients are sharing with you yet."
  <section className="card card--deep">
    <h2 className="card__title">
      "My access history"
    <div className="row row--wrap">
      <button className="btn btn--small" disabled=false type="button">
        "Load access history"
      <span className="hint">
        "Every read and write this portal performed (newest 100) — nothing is loaded until you ask."
  <section className="card card--deep">
    <h2 className="card__title">
      "Account security"
    <div className="row row--wrap">
      <button className="btn btn--ghost btn--small" disabled=false type="button">
        "Show account security"
      <span className="hint">
        "Change your password, recover your sharing key after an interrupted change, or rotate a compromised sharing key — nothing runs until you ask."
  <section className="card card--deep">
    <h2 className="card__title">
      "Clinician data rights"
    <p className="note">
      "This portal does not currently provide a complete clinician-account export or self-service account deletion. Contact your organization's privacy administrator to request an export or deletion. Patient charts can be printed individually from each patient view, but that is not a complete account export.""
`;

