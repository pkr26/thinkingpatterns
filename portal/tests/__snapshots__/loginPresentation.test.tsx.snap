"<main className="login-main">
  <div className="login-wrap">
    <h1 className="login-title">
      "Fathom · Therapist portal"
    <section className="card">
      <h2 className="card__title">
        "Create a therapist account"
      <form className="login-form">
        <div className="field">
          <label className="field__label" htmlFor="field-association-1">
            "Your name (shown to patients)"
          <input autoComplete="name" className="input" id="field-association-1" placeholder="Dr. Jane Omega" type="text" value="">
        <div className="field">
          <label className="field__label" htmlFor="field-association-2">
            "Username"
          <input autoComplete="username" className="input" id="field-association-2" placeholder="dromega" type="text" value="doctor">
        <div className="field">
          <label className="field__label" htmlFor="field-association-3">
            "Password"
          <span className="field__row">
            <input autoComplete="new-password" className="input" id="field-association-3" type="password" value="Strong!pass123">
            <button className="btn btn--ghost btn--small" disabled=false type="button">
              "Show password"
        <div aria-label="Password strength: Good" className="pw-meter" role="status">
          <span className="pw-meter__bar pw-meter__bar--3">
          <span className="pw-meter__bar pw-meter__bar--3">
          <span className="pw-meter__bar pw-meter__bar--3">
          <span className="pw-meter__bar">
          <span className="pw-meter__label pw-meter__label--3">
            "Good"
        <div className="field">
          <label className="field__label" htmlFor="field-association-4">
            "Repeat password"
          <span className="field__row">
            <input autoComplete="new-password" className="input" id="field-association-4" type="password" value="Strong!pass123">
            <button className="btn btn--ghost btn--small" disabled=false type="button">
              "Show password"
        <div className="field">
          <label className="field__label" htmlFor="field-association-5">
            "Clinician enrollment token (if issued)"
          <input autoComplete="one-time-code" className="input" id="field-association-5" placeholder="Organization-issued token" type="password" value="">
        <label className="row">
          <input checked=false type="checkbox">
          <span>
            "I confirm that I am 18 or older."
        <p className="note">
          "Server: this portal's own secure origin. It cannot be changed from the sign-in screen."
        <p className="note">
          "Choose a password of at least 12 characters. Use a 16-character passphrase, or use at least three character types at 12–15 characters."
        <p className="note">
          "If your organization issued a clinician enrollment token, enter it here. It is sent only to this portal's same-origin secure API connection and is never stored by this portal."
        <p className="note note--danger">
          "There is no password reset and no account recovery. Your sharing key is wrapped to this password alone: if you forget it, your account and every shared note become permanently unreadable. Save the password in a password manager before you continue."
        <button className="btn" disabled=true type="submit">
          "Create account"
        <button className="btn btn--small" disabled=false type="button">
          "Back to sign in"
        <details className="disclose">
          <summary>
            "How your password is protected"
          <div className="disclose__body">
            <p className="note note--muted">
              "Your password never leaves this page: the server stores only a hash of a derived key, and your sharing key is decryptable only with your password.""
`;

