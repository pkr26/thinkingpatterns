          <path d="M5.5 11.5a6.5 6.5 0 0 0 13 0">
          <path d="M12 18v3">
        "Record instead"
    <div className="row row--wrap">
      <button className="chip" disabled=false type="button">
        "Somewhere I went today…"
      <button className="chip" disabled=false type="button">
        "I felt most like myself when…"
      <button className="chip" disabled=false type="button">
        "Something that surprised me…"
    <div className="stack" style={"gap":"var(--space-2)"}>
      <button className="btn btn--block" disabled=false type="button">
        <svg aria-hidden="true" fill="none" focusable="false" height=17 stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth=1.8 viewBox="0 0 24 24" width=17>
          <path d="M5 12.5l4.5 4.5L19 7.5">
        "Save entry"
      <span className="row" style={"justifyContent":"center"}>
        <button className="btn btn--ghost btn--small" disabled=true type="button">
          <svg aria-hidden="true" fill="none" focusable="false" height=15 stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth=1.8 viewBox="0 0 24 24" width=15>
            <path d="M6 6l12 12">
            <path d="M18 6 6 18">
          "Discard draft"
      <span className="row" style={"gap":6,"justifyContent":"center"}>
        <svg aria-hidden="true" fill="none" focusable="false" height=14 stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth=1.8 viewBox="0 0 24 24" width=14>
          <path d="M12 3l7 3v5c0 4.5-3 7.6-7 9.2C8 18.6 5 15.5 5 11V6z">
          <path d="M9 11.6l2.1 2.1 4-4.2">
        <span className="note note--muted">
          "Your draft stays on this device, encrypted, until you save or discard it.""
`;

