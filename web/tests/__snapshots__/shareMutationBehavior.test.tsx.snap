exports[`hides a malformed comparison fingerprint independently of a usable server SAS 1`] = `
"<section className="card">
  <h2 className="card__title">
    "Share with a therapist"
  <p className="note note--muted" style={"whiteSpace":"pre-wrap"}>
    "Zero-knowledge: your key is wrapped to your therapist's public key — the server never sees it, and neither does anyone else."
  <label className="field">
    <span className="field__label">
      "Pairing code"
    <input className="input" placeholder="from your therapist's portal" type="text" value="  PAIR1234  ">
  <button className="btn btn--ghost btn--small" disabled=false type="button">
    "Look up"
  <p className="note" role="status" style={"whiteSpace":"pre-wrap"}>
    "Therapist: Dr. Current"
  <div className="stack" style={"gap":"var(--space-1)"}>
    <span className="fingerprint">
      "123 456"
    <p className="note note--muted" style={"whiteSpace":"pre-wrap"}>
      "Your pairing id (also read it to them): sharing-behavior-owner"
    <p className="note note--warn" style={"whiteSpace":"pre-wrap"}>
      "Read this verification code to your therapist — in the room or on the phone — and make sure their portal shows exactly the same one before you share. If it does not match, STOP: a mismatch means the connection was tampered with."
  <div className="stack" style={"gap":"var(--space-1)"}>
    <span className="fingerprint">
      "DERIVED_THERAPIST_FINGERPRINT"
    <span className="row" style={"gap":8}>
      <button className="btn btn--ghost btn--small" disabled=false type="button">
        <svg aria-hidden="true" fill="none" focusable="false" height=15 stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth=1.8 viewBox="0 0 24 24" width=15>
          <rect height="10.5" rx="2" width="10.5" x="9" y="9">
          <path d="M6.5 15H5.5A1.5 1.5 0 0 1 4 13.5v-8A1.5 1.5 0 0 1 5.5 4h8A1.5 1.5 0 0 1 15 5.5v1">
        "Copy fingerprint"
  <p className="note note--warn" style={"whiteSpace":"pre-wrap"}>
    "Read this fingerprint back to your therapist (in the room or on the phone). If it does not match what their portal shows, STOP — a mismatch means the key was substituted."
  <label className="checkbox">
    <input checked=false className="checkbox__input" type="checkbox">
    <span aria-hidden="true" className="checkbox__box">
      <span className="checkbox__check">
        <svg aria-hidden="true" fill="none" focusable="false" height=13 stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth=1.8 viewBox="0 0 24 24" width=13>
          <path d="M5 12.5l4.5 4.5L19 7.5">
    <span>
      "We read the key fingerprint back to each other and it MATCHED. (A substituted key would decrypt nothing — but checking is the only proof the right therapist is on the other end.)"
  <label className="checkbox">
    <input checked=false className="checkbox__input" type="checkbox">
    <span aria-hidden="true" className="checkbox__box">
      <span className="checkbox__check">
        <svg aria-hidden="true" fill="none" focusable="false" height=13 stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth=1.8 viewBox="0 0 24 24" width=13>
          <path d="M5 12.5l4.5 4.5L19 7.5">
    <span>
      "I understand: they can read my patterns and the decrypted entries behind them; every read is audit-logged; revoking ends access immediately but cannot unread what has already been seen."
  <button className="btn" disabled=true type="button">
    <svg aria-hidden="true" fill="none" focusable="false" height=17 stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth=1.8 viewBox="0 0 24 24" width=17>
      <circle cx="18" cy="5.5" r="2.4">
      <circle cx="6" cy="12" r="2.4">
      <circle cx="18" cy="18.5" r="2.4">
      <path d="M8.2 10.8l7.6-4.1">
      <path d="M8.2 13.2l7.6 4.1">
    "Confirm and share"
<section className="card">
  <h2 className="card__title">
    "Your grants"
  <p className="note" style={"whiteSpace":"pre-wrap"}>
    "No active grants — your journal is shared with no one.""
`;

