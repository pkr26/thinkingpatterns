exports[`clears revocation arming before a concurrent relationship reappears in the refreshed listing 1`] = `
"<section className="card">
  <h2 className="card__title">
    "Share with a therapist"
  <p className="note note--muted" style={"whiteSpace":"pre-wrap"}>
    "Zero-knowledge: your key is wrapped to your therapist's public key — the server never sees it, and neither does anyone else."
  <label className="field">
    <span className="field__label">
      "Pairing code"
    <input className="input" placeholder="from your therapist's portal" type="text" value="">
  <button className="btn btn--ghost btn--small" disabled=false type="button">
    "Look up"
  <span className="pill-note pill-note--ok" role="status">
    <svg aria-hidden="true" fill="none" focusable="false" height=14 stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth=1.8 viewBox="0 0 24 24" width=14>
      <path d="M5 12.5l4.5 4.5L19 7.5">
    "Revoked — Dr. Current loses access immediately. What they already read cannot be unread."
<section className="card">
  <h2 className="card__title">
    "Your grants"
  <div className="entry-card">
    <div className="row" style={"gap":12,"alignItems":"center"}>
      <span aria-hidden="true" className="avatar">
        "DC"
      <div className="stack" style={"gap":2,"flex":1}>
        <strong style={"fontSize":"var(--text-md)","color":"var(--text)"}>
          "Dr. Current"
        <p className="note note--muted" style={"whiteSpace":"pre-wrap"}>
          "Sharing since 2026-10-01"
    <div className="row row--between">
      <span className="note" style={"whiteSpace":"pre-wrap"}>
        "Therapist cannot hear my recordings"
      <button aria-checked=false aria-label="Therapist cannot hear my recordings" className="toggle" disabled=false role="switch" type="button">
    <div className="row row--end">
      <button className="btn btn--danger btn--small" disabled=false type="button">
        "Revoke access""
`;

exports[`displays pairing progress and clears prior success before the next lookup completes 1`] = `
"<section className="card">
  <h2 className="card__title">
    "Share with a therapist"
  <p className="note note--muted" style={"whiteSpace":"pre-wrap"}>
    "Zero-knowledge: your key is wrapped to your therapist's public key — the server never sees it, and neither does anyone else."
  <label className="field">
    <span className="field__label">
      "Pairing code"
    <input className="input" placeholder="from your therapist's portal" type="text" value="NEXT-CODE">
  <button className="btn btn--ghost btn--small" disabled=true type="button">
    "Working…"
<section className="card">
  <h2 className="card__title">
    "Your grants"
  <p className="note" style={"whiteSpace":"pre-wrap"}>
    "No active grants — your journal is shared with no one.""
`;

