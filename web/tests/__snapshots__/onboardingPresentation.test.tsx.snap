// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shows all three onboarding panels with usable completion controls in en 1`] = `
"<div className="onboard-wrap">
  <section className="card">
    <h2 className="card__title">
      "A journal that is yours alone"
    <div aria-hidden="true" className="panel-art">
      <svg aria-hidden="true" fill="none" focusable="false" height=44 stroke="currentColor" strokeLinecap="round" strokeLinejoin="round" strokeWidth=1.8 viewBox="0 0 24 24" width=44>
        <path d="M12 3l7 3v5c0 4.5-3 7.6-7 9.2C8 18.6 5 15.5 5 11V6z">
        <path d="M9 11.6l2.1 2.1 4-4.2">
    <p className="note note--lead" style={"whiteSpace":"pre-wrap"}>
      "Write daily. Everything you write is encrypted on this device before it leaves — the server stores only opaque ciphertext, forever. Not advice, not diagnosis: observations, each with its evidence."
    <div className="row row--wrap" style={"gap":10}>
      <div aria-label="Step 1 of 3" className="dots" role="img">
        <span className="dots__dot dots__dot--on">
        <span className="dots__dot">
        <span className="dots__dot">
      <span className="note note--muted">
        "Step 1 of 3"
    <button className="btn btn--block" disabled=false type="button">
      "Next""
`;

