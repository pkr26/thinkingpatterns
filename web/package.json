{
  "name": "mindpattern-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MindPattern patient web client — the mobile app's journaling experience in the browser, same zero-knowledge contract (WEB_PLAN.md).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/add-sri.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "react-test-renderer": "19.1.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
